// Date: Jan 1, 2010
//------------------------------------------------

ServerHost = localhost
ServerPort = 9000
//Simulator  = true

Community    = moosros
MOOSTimeWarp = 1

Processconfig = ANTLER
{
  MSBetweenLaunches = 100
   
  Run = MOOSDB           @ NewConsole = false
//  Run = MOOS_ROS_BRIDGE  @ NewConsole = false
  Run = uMS              @ NewConsole = true 
  Run = pEchoVar         @ NewConsole = false 
}

ProcessConfig = MOOS_ROS_BRIDGE
{
  AppTick    = 1
  CommsTick  = 20
}

ProcessConfig = pEchoVar
{
  AppTick    = 10
  CommsTick  = 10
  echo = ROSCNT32 -> MOOSCNT32
  echo = ROSCNT64 -> MOOSCNT64
  echo = ROSCNTF32 -> MOOSCNTF32
  echo = ROSCNTF64 -> MOOSCNTF64
  echo = ROSCNTSTR -> MOOSCNTSTR
}

ProcessConfig = uMS
{
  AppTick    = 4
  CommsTick  = 4
}
